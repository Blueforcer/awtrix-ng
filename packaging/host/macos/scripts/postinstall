#!/bin/sh
set -u
APP="/Applications/AWTRIX Script Host.app"
FIREWALL=/usr/libexec/ApplicationFirewall/socketfilterfw

if [ -x "$FIREWALL" ]; then
  for program in "AWTRIX Script Host" awtrix-host awtrix-script-runner; do
    "$FIREWALL" --add "$APP/Contents/MacOS/$program" >/dev/null 2>&1
    "$FIREWALL" --unblockapp "$APP/Contents/MacOS/$program" >/dev/null 2>&1
  done
fi

user=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$user" ] && [ "$user" != root ] && [ "$user" != loginwindow ]; then
  launchctl asuser "$(id -u "$user")" sudo -u "$user" /usr/bin/open "$APP" >/dev/null 2>&1 || true
fi
exit 0
