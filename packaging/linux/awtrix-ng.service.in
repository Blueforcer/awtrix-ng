[Unit]
Description=AWTRIX NG hardened Linux application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
DynamicUser=yes
StateDirectory=awtrix-ng
StateDirectoryMode=0700
UMask=0077
Environment=AWTRIX_LISTEN=127.0.0.1
Environment=AWTRIX_PORT=8443
EnvironmentFile=/etc/awtrix-ng/service.env
LoadCredential=admin.token:/etc/awtrix-ng/admin.token
LoadCredential=tls.crt:/etc/awtrix-ng/tls.crt
LoadCredential=tls.key:/etc/awtrix-ng/tls.key
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/awtrix-linux --hardened --data /var/lib/awtrix-ng --webui @CMAKE_INSTALL_FULL_DATADIR@/awtrix-ng/index.html --port ${AWTRIX_PORT} --listen ${AWTRIX_LISTEN} --origin ${AWTRIX_ORIGIN} --credentials-file %d/admin.token --tls-cert %d/tls.crt --tls-key %d/tls.key
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitCORE=0
TasksMax=128

[Install]
WantedBy=multi-user.target
