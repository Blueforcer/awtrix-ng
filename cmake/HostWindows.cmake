include_guard(GLOBAL)

enable_language(RC)
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" AWTRIX_VERSION_PARTS "${AWTRIX_VERSION}")
set(AWTRIX_RC_VERSION "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
set(AWTRIX_RC_MANIFEST "${PROJECT_SOURCE_DIR}/packaging/host/windows/awtrix.manifest")
foreach(program awtrix-host awtrix-script-runner)
  if(program STREQUAL "awtrix-host")
    set(AWTRIX_RC_DESCRIPTION "AWTRIX Script Host")
  else()
    set(AWTRIX_RC_DESCRIPTION "AWTRIX Script Runner")
  endif()
  set(AWTRIX_RC_PROGRAM "${program}")
  configure_file("${PROJECT_SOURCE_DIR}/packaging/host/windows/program.rc.in" "${program}.rc" @ONLY)
  target_sources(${program} PRIVATE "${PROJECT_BINARY_DIR}/${program}.rc")
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_link_options(${program} PRIVATE -static -s)
  endif()
endforeach()
