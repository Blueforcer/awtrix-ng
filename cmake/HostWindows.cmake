include_guard(GLOBAL)

enable_language(RC)
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" AWTRIX_VERSION_PARTS "${AWTRIX_VERSION}")
set(AWTRIX_RC_VERSION "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
set(AWTRIX_RC_MANIFEST "${PROJECT_SOURCE_DIR}/packaging/host/windows/awtrix.manifest")
set(AWTRIX_RC_ICON "${PROJECT_SOURCE_DIR}/tools/tc002/desktop/native/icons/icon.ico")

set(TRAY_DIR "${PROJECT_SOURCE_DIR}/src/platform/host/app/win32")
add_library(awtrix_tray_host STATIC "${TRAY_DIR}/TiedHost.cpp")
target_link_libraries(awtrix_tray_host PUBLIC awtrix_hostapp PRIVATE awtrix_os awtrix_warnings)

add_library(awtrix_tray STATIC "${TRAY_DIR}/StartAtLogin.cpp" "${TRAY_DIR}/RunRegistry.cpp" "${TRAY_DIR}/MenuText.cpp"
  "${TRAY_DIR}/TrayImage.cpp" "${TRAY_DIR}/HostLayout.cpp" "${TRAY_DIR}/TrayController.cpp")
target_compile_definitions(awtrix_tray PUBLIC WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 WINVER=0x0A00)
target_link_libraries(awtrix_tray PUBLIC awtrix_hostapp gdi32 advapi32 PRIVATE awtrix_warnings)

add_executable(awtrix-script-host WIN32 "${TRAY_DIR}/main.cpp" "${TRAY_DIR}/TrayWindow.cpp" "${TRAY_DIR}/WinShell.cpp")
set_target_properties(awtrix-script-host PROPERTIES OUTPUT_NAME "AWTRIX Script Host")
target_compile_definitions(awtrix-script-host PRIVATE "AWTRIX_NG_VERSION=\"${AWTRIX_VERSION}\"")
target_link_libraries(awtrix-script-host PRIVATE awtrix_tray awtrix_tray_host shell32 user32 ole32 uuid awtrix_warnings)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  target_link_options(awtrix-script-host PRIVATE -municode)
endif()

foreach(program awtrix-host awtrix-script-runner awtrix-script-host)
  set(AWTRIX_RC_PROGRAM "${program}")
  set(AWTRIX_RC_DESCRIPTION "AWTRIX Script Host")
  if(program STREQUAL "awtrix-host")
    set(AWTRIX_RC_DESCRIPTION "AWTRIX Script Host Engine")
  elseif(program STREQUAL "awtrix-script-runner")
    set(AWTRIX_RC_DESCRIPTION "AWTRIX Script Runner")
  elseif(program STREQUAL "awtrix-script-host")
    set(AWTRIX_RC_PROGRAM "AWTRIX Script Host")
  endif()
  configure_file("${PROJECT_SOURCE_DIR}/packaging/host/windows/program.rc.in" "${program}.rc" @ONLY)
  target_sources(${program} PRIVATE "${PROJECT_BINARY_DIR}/${program}.rc")
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_link_options(${program} PRIVATE -static -s)
  endif()
endforeach()
