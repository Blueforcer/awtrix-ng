# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Release artefacts (scripts/factory_image.py, CI "Stage ... images" steps)
dist/

# Editors
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/

# Build / OS
*.bin
*.elf
*.o
*.a
.DS_Store
Thumbs.db

# Web UI test dependencies (webui/index.html itself is checked in)
node_modules/

# Local secrets / device config
secrets.h
*.local

# Host simulator data directory (icons/settings created at runtime)
simdata/

# MkDocs build output (built by .github/workflows/docs.yml, deployed to Pages)
site/
# Firmware for the browser flasher: downloaded from the newest release during
# the docs build, published with the site, never committed.
docs/firmware/
__pycache__/

# Local Berry scripts (uploaded to the device, not part of the firmware)
/Berry/
