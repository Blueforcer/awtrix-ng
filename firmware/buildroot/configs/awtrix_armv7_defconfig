# Experimental ARM userspace baseline. This is not a TC002 board definition.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.18.52"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y
BR2_REPRODUCIBLE=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AWTRIX_PATH)/scripts/post-build.sh"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_AWTRIX_PATH)/patches"
# No board boot process, login service, or interactive target shell yet.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_ENABLE_DEBUG is not set
# BR2_PACKAGE_GDB is not set
# BR2_PACKAGE_HOST_GDB is not set
# BR2_PACKAGE_DROPBEAR is not set
# BR2_PACKAGE_OPENSSH is not set
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_AWTRIX_NG=y
# Header selection above does not build or validate a kernel.
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_UBOOT is not set
# BR2_TARGET_BAREBOX is not set
# BR2_TARGET_ARM_TRUSTED_FIRMWARE is not set
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_NONE=y
